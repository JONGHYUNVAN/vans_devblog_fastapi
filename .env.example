# Elasticsearch: 스킴과 포트 없이 호스트만. https://{host} 로 접속한다.
ELASTICSEARCH_HOST=es.vansdevblog.online
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_VERIFY_CERTS=true

# MongoDB: URI 방식 우선. DATABASE가 비어 있으면 URI 경로에서 추출한다.
MONGODB_URI=
MONGODB_DATABASE=

# NestJS Post BE 가 X-Internal-Key 로 보내는 키. 동기화 실행(POST sync/, sync/all/)도 이 키를 요구한다. 비어 있으면 둘 다 403.
INTERNAL_API_KEY=
# 에이전트 내부 API(/api/v1/agents/)의 X-Internal-Key. 검색 내부 키와 나눈다(설계 07 문서 D-44). 비어 있으면 403.
AGENTS_INTERNAL_API_KEY=

# KIS OpenAPI. APP_KEY 가 비어 있으면 KIS 엔드포인트는 degraded 응답.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_IS_REAL=false

# CORS: 쉼표 구분. *.cloudtype.app 은 기본 허용.
CORS_ALLOWED_ORIGINS=
FRONTEND_HOSTS=

PORT=8000

# 에이전트 파이프라인 상수. 비우면 Settings 기본값(설계 06 문서 4절). 벤더 키·슬롯 바인딩·발행 계정은 해당 단계에서 더한다.
DRAFT_TOKEN_LIMIT=300000
MAX_LLM_RETRIES=3
LLM_CONCURRENCY_PER_PROVIDER=2
# 켜져 있으면(기본) READY_TO_PUBLISH 글은 사람 승인(approve)을 기다린다.
PUBLISH_REQUIRES_APPROVAL=true

# LLM 벤더 키. 키가 있는 벤더만 LLM 레지스트리에 들어간다. 바인딩의 provider 는 anthropic | google | xai.
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
# 슬롯 바인딩(JSON). persona_id 는 architect | systems_engineer | troubleshooter 이고 세 슬롯의 페르소나가 서로 달라야 한다.
AGENT_SLOT_BINDINGS={"A":{"provider":"anthropic","model_id":"claude-opus-5-5","persona_id":"architect","max_output_tokens":16000},"B":{"provider":"google","model_id":"gemini-4-argon","persona_id":"systems_engineer","max_output_tokens":16000},"C":{"provider":"xai","model_id":"grok-4.7","persona_id":"troubleshooter","max_output_tokens":16000}}
# Post BE(vans_story_be_post). 라운드 생성 때 활성 카테고리를 읽고, 승인된 글을 POST /api/v1/posts 로 발행한다.
POST_BE_URL=
PUBLISH_TIMEOUT_S=30
# 발행 계정: vans_story_be(USER_SERVICE_URL)에 로그인하는 벤더별 관리자 계정. 글을 쓴 슬롯의 벤더 계정이 게시글 작성자가 된다(설계 07 문서 D-40·D-45). 그 벤더 계정이 비어 있으면 발행 단계가 INTERNAL_ERROR 로 멈춘다.
USER_SERVICE_URL=
ANTHROPIC_PUBLISHER_EMAIL=
ANTHROPIC_PUBLISHER_PASSWORD=
GOOGLE_PUBLISHER_EMAIL=
GOOGLE_PUBLISHER_PASSWORD=
XAI_PUBLISHER_EMAIL=
XAI_PUBLISHER_PASSWORD=

# 코드 그래프(code_graph_design/README.md). 저장소 키 → 설정(JSON 한 줄). 네 저장소 전체 예시는 code_graph_design/repos.example.json 이다. {} 이면 기능이 꺼진다(빈 값은 JSON 이 아니라 기동 실패).
CODE_GRAPH_REPOS={}
# GitHub tarball 다운로드 타임아웃(초)과 크기 상한(MB). 상한을 넘으면 분석 요청이 503 이다.
CODE_GRAPH_DOWNLOAD_TIMEOUT_S=30
CODE_GRAPH_MAX_TARBALL_MB=64
# 서비스 그래프(B)의 NestJS·Spring OpenAPI 조회. 호스트는 POST_BE_URL·USER_SERVICE_URL 이다. 비어 있으면 그 서비스의 스키마만 빈다
CODE_GRAPH_OPENAPI_TIMEOUT_S=10
# NestJS swagger-json 은 Swagger 비밀번호 세션 뒤에 있다(vans_story_be_post 의 SWAGGER_ADMIN_PASSWORD 와 같은 값)
POST_BE_SWAGGER_PASSWORD=
