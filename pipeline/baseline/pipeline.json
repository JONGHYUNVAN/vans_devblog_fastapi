  "level_criteria": {
    "version": "v1",
    "criteria": [
      {
        "level": 100,
        "name": "입문",
        "core_question": "어떻게 쓰는가",
        "prerequisites": "없음",
        "assessment": "용어를 처음 듣는 독자가 끝까지 읽고 따라 할 수 있다. 개념을 한 문장으로 정의하고 바로 일상 예시(블로그 서비스의 사용자·게시글·댓글처럼)로 보여 준다. 문장은 짧고(20~30자) 작은 제목 아래 2~4문장씩 끊으며, 코드는 5~10줄 조각마다 주석 한 줄. 증명 스크립트·변경 전후 비교는 쓰지 않는다",
        "evidence": "공식 문서. 작은 코드 조각과 그 실행 결과"
      },
      {
        "level": 200,
        "name": "응용 기초",
        "core_question": "어떻게 제대로 쓰는가",
        "prerequisites": "기본 사용 경험",
        "assessment": "방법과 그 이유를 함께 설명한다. 입문과 같은 호흡(짧은 문장, 작은 제목, 일상 예시, 주석 달린 작은 코드 조각)을 유지하되 단계마다 '왜 이렇게 하는가'를 붙인다. 심화(300)의 변경 전후 코드·테스트 증명은 요구하지 않는다",
        "evidence": "실행 가능한 코드와 그 결과"
      },
      {
        "level": 300,
        "name": "심화",
        "core_question": "이 결정이 왜 따라오고 코드가 어떻게 바뀌는가",
        "prerequisites": "여러 접근을 직접 써 본 경험",
        "assessment": "선택한 전환이나 설계 결정 하나의 인과를 변경 전후 코드로 깊게 설명한다",
        "evidence": "변경 전후 코드와 테스트. 표준 시나리오도 된다"
