    "reference_posts": [
      {
        "title": "데이터 모델의 이해",
        "level": 100,
        "excerpt": "데이터 모델링은 소프트웨어 개발에서 핵심적인 역할을 담당하는 활동 중 하나입니다. 쉽게 말해, 데이터 모델링은 데이터의 구조와 관계를 설계하는 과정으로, 시스템이 어떻게 데이터를 저장하고 관리할지를 미리 정의하는 작업입니다. 예를 들어, 블로그 서비스를 개발한다면 사용자(User), 게시글(Post), 댓글(Comment) 같은 데이터가 필요할 것입니다. 각각의 데이터는 어떤 속성(예: 사용자 이름, 게시글 제목, 댓글 내용)을 가져야 하고, 서로 어떤 관계(예: 사용자가 게시글을 작성, 게시글에 댓글이 달림)를 맺어야 하는지 정해야 합니다.",
        "note": "100~200 수준의 기준 글(블로그 database-theory/681c7f6d926e79afe6f3b2ad). 합쇼체(~습니다), 문장 평균 23자, 작은 제목마다 2~4문장, 개념 정의 → 일상 예시 → 정리 순서, 5~10줄 코드 조각마다 주석 한 줄. 증명 스크립트가 없다"
      }
    ]
  },
  "parameters": {
    "max_iterations": 2,
    "max_validation_retries": 2,
    "max_llm_retries": 3,
    "max_publish_attempts": 3,
    "max_topic_attempts": 2,
    "draft_token_limit": 300000,
    "topic_keyword_overlap": 0.5,
    "topic_title_overlap": 0.5,
    "topic_avoid_lookback_days": 180,
    "draft_min_chars": 4000,
    "draft_max_chars": 20000,
    "min_code_blocks": 1,
    "structure": {
      "required_sections": [
        "intro",
        "body-1",
        "tradeoff"
      ],
      "sections_optional_by_level": {
        "100": [
          "tradeoff"
        ]
      },
      "anchor_format": "<!-- sec:{id} -->",
      "forbidden_syntax": [
        "HTML tags (except section anchors)",
        "Images (![alt](url))",
        "Footnotes",
        "mermaid code blocks"
      ],
      "language": "ko"
    },
    "review": {
      "tone_preservation": {
        "may_flag": [
          "Factual errors or specification mismatches",
          "Logical leaps or broken causal links",
          "Code bugs, syntax errors, or body-code contradictions",
          "Sentence structures that obstruct comprehension",
          "Hollow filler phrases or cliched AI introductions/summaries"
        ],
        "must_not_flag": [
          "First-person narrative choice",
          "Sentence rhythm and length preferences",
          "Direct or assertive tone",
          "Choosing prose paragraphs over bullet lists"
        ]
      }
    },
    "fact_check": {
      "severity": {
        "REFUTED": "CRITICAL",
        "UNVERIFIABLE": "MINOR"
      }
    },
    "final_read": {
      "blocking_kinds": [
        "BODY_CODE_CONTRADICTION",
        "CORE_MECHANISM_MISSING"
      ]
    },
    "polish": {
      "phrase_fixes": [
        [
          "하십시오",
          "한다"
        ],
        [
          "(?<=\\S)라고 볼 수 있다",
          "다"
        ],
        [
          "(?<=\\S)인 상황이다",
          "이다"
        ]
      ],
      "long_paragraph_chars": 300,
      "length_slack_chars": 30,
      "length_slack_ratio": 0.25
    },
    "publish": {
      "requires_approval": true,
      "note": {
        "heading": "## AI Information",
        "writer": "- 작성: $models",
        "reviewers": "- 리뷰: $models",
        "revisers": "- 수정: $models",
        "arbiters": "- 중재: $models",
        "polishers": "- 다듬기: $models",
        "lens_labels": {
          "LOGIC_READABILITY": "논리·가독성",
          "FACT_STRUCTURE": "사실·구조",
          "CRITICAL_PRACTICAL": "비판·실무"
        }
      }
    },
    "glossary": {
      "full_list_max": 300,
      "min_terms": 8,
      "max_terms": 12,
      "surface_max_chars": 40,
      "terminology_max": 150
    },
    "style": {
      "minority_register_ratio": 0.1,
      "minority_register_min": 3,
      "forbid_imperatives": true
    },
    "code_comments": {
      "min_lines": 12,
      "lines_per_comment": 25
    },
    "prompt_lint": {}
  }
